# Neo4j AuraDB Connection Configuration
NEO4J_URI=neo4j+s://<your-auradb-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Groq API Configuration (OpenAI Python SDK Compatible)
GROQ_API_KEY=gsk_your_groq_api_key_here

# FastAPI Backend Security & Runtime Configuration
ENVIRONMENT=development
BACKEND_API_TOKEN=replace-with-random-secret-token-for-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CHAT_RATE_LIMIT_PER_MINUTE=20
API_RATE_LIMIT_PER_MINUTE=180
