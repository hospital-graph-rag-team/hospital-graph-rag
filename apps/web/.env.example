# Server-side FastAPI backend URL (never prefix with NEXT_PUBLIC_)
BACKEND_URL=http://127.0.0.1:8000

# Private server-to-server token matching FastAPI BACKEND_API_TOKEN
BACKEND_API_TOKEN=replace-with-matching-backend-token

# Optional lightweight demo access code (if set, users enter this once in the UI)
DEMO_ACCESS_CODE=
